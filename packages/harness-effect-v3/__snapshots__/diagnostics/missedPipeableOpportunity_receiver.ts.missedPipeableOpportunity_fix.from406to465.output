// code fix missedPipeableOpportunity_fix  output for range 406 - 465
// @effect-diagnostics missedPipeableOpportunity:warning
// @test-config {"pipeableMinArgCount": 1}
import * as Schema from "effect/Schema"

const Inner = Schema.Struct({ a: Schema.String })

// should trigger on the receiver of .annotations
export const B = Schema.NullishOr(Inner).annotations({ identifier: "B" })

// should trigger on the receiver and on the nested Schema.Array(Inner)
export const C = Schema.Struct({ x: Schema.Array(Inner) }).pipe(Schema.NullishOr).annotations({ identifier: "C" })

// should trigger with the merged suggestion Inner.pipe(Schema.Array, Schema.minItems(1))
export const D = Schema.Array(Inner).pipe(Schema.minItems(1))
